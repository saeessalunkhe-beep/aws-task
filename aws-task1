<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kuromi · Fan Page</title>
<meta name="description" content="An unofficial fan page about Kuromi: backstory, facts and a Halloween countdown.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Nunito:wght@400;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0d0714; --plum:#1b0f2e; --violet:#7b2cbf; --lilac:#c9a7ff; --pink:#ff5fa8; --bone:#f6efff;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--ink);color:var(--bone);font-family:'Nunito',system-ui,sans-serif;line-height:1.65;overflow-x:hidden}
h1,h2,h3{font-family:'Shrikhand',cursive;font-weight:400;line-height:1.1}
a{color:inherit}
:focus-visible{outline:3px solid var(--pink);outline-offset:3px}
 
/* background */
body::before{content:"";position:fixed;inset:0;z-index:-2;
  background:radial-gradient(60% 50% at 80% 0%,rgba(123,44,191,.45),transparent),
             radial-gradient(50% 40% at 0% 100%,rgba(255,95,168,.18),transparent),var(--ink)}
#stars{position:fixed;inset:0;z-index:-1;pointer-events:none}
 
/* nav */
nav{position:sticky;top:0;z-index:20;display:flex;justify-content:space-between;align-items:center;
  padding:.8rem 5vw;background:rgba(13,7,20,.8);backdrop-filter:blur(8px);border-bottom:2px dashed var(--violet)}
nav b{font-family:'Shrikhand';font-size:1.4rem;color:var(--pink)}
nav div a{margin-left:1.2rem;text-decoration:none;font-weight:800;opacity:.85}
nav div a:hover{color:var(--pink);opacity:1}
 
section{padding:5rem 5vw;max-width:1100px;margin:auto}
h2{font-size:clamp(2rem,5vw,3.2rem);margin-bottom:1.5rem;color:var(--lilac)}
 
/* hero */
.hero{min-height:88vh;display:grid;grid-template-columns:1.1fr .9fr;gap:2rem;align-items:center}
.hero h1{font-size:clamp(4rem,13vw,9rem);color:var(--bone);text-shadow:4px 4px 0 var(--violet),8px 8px 0 var(--pink);cursor:pointer;user-select:none;transition:transform .2s}
.hero h1:hover{transform:rotate(-3deg) scale(1.03)}
.hero h1.shake{animation:shake .5s}
@keyframes shake{20%{transform:translateX(-10px) rotate(-4deg)}40%{transform:translateX(10px) rotate(4deg)}60%{transform:translateX(-6px)}80%{transform:translateX(6px)}}
.tag{font-size:1.3rem;margin:1rem 0 2rem;min-height:2em;color:var(--lilac);font-weight:800}
.tag::after{content:"▌";animation:blink 1s steps(1) infinite;color:var(--pink)}
@keyframes blink{50%{opacity:0}}
.btn{display:inline-block;padding:.8rem 1.6rem;border:3px solid var(--pink);border-radius:999px;background:var(--pink);
  color:var(--ink);font-weight:800;font-size:1rem;cursor:pointer;text-decoration:none;font-family:inherit;transition:.2s}
.btn:hover{background:transparent;color:var(--pink);transform:translateY(-3px)}
.btn.ghost{background:transparent;color:var(--bone);border-color:var(--violet);margin-left:.6rem}
.btn.ghost:hover{border-color:var(--lilac);color:var(--lilac)}
 
/* image slots */
.slot{position:relative;border:4px solid var(--violet);border-radius:28px;overflow:hidden;background:var(--plum);
  box-shadow:10px 10px 0 var(--pink);aspect-ratio:4/5}
.slot img{width:100%;height:100%;object-fit:cover;display:block}
.slot.missing img{display:none}
.slot.missing::after{content:"Add image:\A " attr(data-file);white-space:pre;position:absolute;inset:0;display:grid;place-items:center;
  text-align:center;padding:1rem;color:var(--lilac);font-weight:800;
  background:repeating-linear-gradient(45deg,var(--plum) 0 14px,#24143d 14px 28px)}
.hero .slot{transform:rotate(3deg);transition:transform .3s}
.hero .slot:hover{transform:rotate(-1deg) scale(1.02)}
 
/* tabs */
.tabs{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:1.5rem}
.tabs button{padding:.6rem 1.2rem;border-radius:999px;border:2px solid var(--violet);background:transparent;color:var(--bone);
  font:800 1rem 'Nunito';cursor:pointer;transition:.2s}
.tabs button[aria-selected=true]{background:var(--violet);border-color:var(--lilac)}
.tabs button:hover{border-color:var(--pink)}
.panel{background:var(--plum);border:2px solid var(--violet);border-radius:24px;padding:2rem;max-width:70ch;animation:pop .35s}
.panel[hidden]{display:none}
.panel h3{color:var(--pink);font-size:1.8rem;margin-bottom:.8rem}
@keyframes pop{from{opacity:0;transform:scale(.96)}}
 
/* flip cards */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.4rem}
.card{perspective:900px;height:220px;cursor:pointer;background:none;border:0;color:inherit;font:inherit;text-align:center}
.card i{position:absolute;inset:0;display:grid;place-items:center;padding:1.2rem;border-radius:22px;
  border:3px solid var(--violet);backface-visibility:hidden;font-style:normal;transition:transform .6s}
.card{position:relative}
.card .f{background:var(--plum);font-family:'Shrikhand';font-size:1.7rem;color:var(--lilac)}
.card .b{background:var(--violet);transform:rotateY(180deg);font-weight:700}
.card.on .f{transform:rotateY(-180deg)}
.card.on .b{transform:rotateY(0)}
 
/* countdown */
.count{text-align:center;background:linear-gradient(135deg,var(--violet),#3a1466);border:4px solid var(--pink);border-radius:32px;padding:3rem 1.5rem}
.count .t{display:flex;justify-content:center;gap:1rem;flex-wrap:wrap;margin:1.5rem 0}
.count .t div{background:var(--ink);border-radius:18px;padding:1rem 1.4rem;min-width:90px}
.count .t b{display:block;font-family:'Shrikhand';font-size:2.6rem;color:var(--pink);font-weight:400}
 
/* gallery */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.4rem}
.grid .slot{aspect-ratio:1;cursor:zoom-in;box-shadow:6px 6px 0 var(--violet);transition:transform .25s}
.grid .slot:hover{transform:translateY(-6px) rotate(-2deg)}
#lb{position:fixed;inset:0;background:rgba(13,7,20,.92);display:none;place-items:center;z-index:50;cursor:zoom-out;padding:5vw}
#lb.on{display:grid}
#lb img{max-width:100%;max-height:85vh;border:4px solid var(--pink);border-radius:20px}
 
footer{text-align:center;padding:3rem 5vw;border-top:2px dashed var(--violet);color:var(--lilac);font-size:.9rem}
.sp{position:fixed;pointer-events:none;z-index:99;font-size:18px;animation:fly .9s forwards}
@keyframes fly{to{transform:translate(var(--x),var(--y)) scale(.2) rotate(180deg);opacity:0}}
 
@media(max-width:800px){.hero{grid-template-columns:1fr;text-align:center}.hero .slot{max-width:340px;margin:auto}.btn.ghost{margin:.6rem 0 0}nav div a{margin-left:.7rem}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<canvas id="stars" aria-hidden="true"></canvas>
 
<nav>
  <b>Kuromi</b>
  <div><a href="#story">Story</a><a href="#facts">Facts</a><a href="#halloween">Halloween</a><a href="#gallery">Gallery</a></div>
</nav>
 
<section class="hero" id="top">
  <div>
    <h1 id="title" title="Click me">Kuromi</h1>
    <p class="tag" id="tag" aria-live="polite"></p>
    <a class="btn" href="#story">Read her story</a>
    <button class="btn ghost" id="boo">Cause mischief</button>
  </div>
  <div class="slot" data-file="images/hero.jpg"><img src="images/hero.jpg" alt="Kuromi artwork"></div>
</section>
 
<section id="story">
  <h2>Her backstory</h2>
  <div class="tabs" role="tablist">
    <button role="tab" aria-selected="true" data-p="p1">Debut</button>
    <button role="tab" aria-selected="false" data-p="p2">The rivalry</button>
    <button role="tab" aria-selected="false" data-p="p3">Baku</button>
    <button role="tab" aria-selected="false" data-p="p4">The look</button>
  </div>
  <div class="panel" id="p1"><h3>Enter the troublemaker</h3>
    <p>Kuromi is a Sanrio character who first appeared in 2005 in the anime <em>Onegai My Melody</em>. She was created as a rival for My Melody, and her name comes from the Japanese word for black, "kuro". She grew from a side character into one of Sanrio's most popular faces.</p></div>
  <div class="panel" id="p2" hidden><h3>Rival, not villain</h3>
    <p>In the anime, Kuromi pictures herself as a rebellious punk who is always scheming to outshine My Melody. Her plans usually flop. Underneath the attitude she is more soft-hearted than she lets on, which is a big part of why fans love her.</p></div>
  <div class="panel" id="p3" hidden><h3>Her sidekick</h3>
    <p>Kuromi is rarely alone. Baku, her tapir-like sidekick, tags along with her schemes. Sanrio's official profile and the anime tell the story a little differently in places, so the fun details change depending on where you look.</p></div>
  <div class="panel" id="p4" hidden><h3>Black, purple and pink</h3>
    <p>Her signature outfit is a black jester-style hood with a small pink skull on the front, plus a devilish tail. The mix of cute and spooky is exactly why this page is purple and black.</p></div>
</section>
 
<section id="facts">
  <h2>Quick facts</h2>
  <p style="margin-bottom:1.2rem;opacity:.8">Tap a card to flip it.</p>
  <div class="cards">
    <button class="card"><i class="f">Birthday</i><i class="b">October 31, which is Halloween.</i></button>
    <button class="card"><i class="f">Debut</i><i class="b">2005, in the anime Onegai My Melody.</i></button>
    <button class="card"><i class="f">Rival</i><i class="b">My Melody, her sweet and sunny opposite.</i></button>
    <button class="card"><i class="f">Sidekick</i><i class="b">Baku, who follows her into every scheme.</i></button>
    <button class="card"><i class="f">Vibe</i><i class="b">Punk on the outside, soft on the inside.</i></button>
  </div>
</section>
 
<section id="halloween">
  <div class="count">
    <h2 style="color:var(--bone)">Countdown to her birthday</h2>
    <div class="t" id="cd"></div>
    <p id="cdmsg" style="font-weight:800"></p>
  </div>
</section>
 
<section id="gallery">
  <h2>Gallery</h2>
  <p style="margin-bottom:1.2rem;opacity:.8">Click an image to enlarge it.</p>
  <div class="grid">
    <div class="slot" data-file="images/1.jpg"><img src="images/1.jpg" alt="Kuromi picture 1"></div>
    <div class="slot" data-file="images/2.jpg"><img src="images/2.jpg" alt="Kuromi picture 2"></div>
    <div class="slot" data-file="images/3.jpg"><img src="images/3.jpg" alt="Kuromi picture 3"></div>
    <div class="slot" data-file="images/4.jpg"><img src="images/4.jpg" alt="Kuromi picture 4"></div>
  </div>
</section>
 
<div id="lb" role="dialog" aria-label="Enlarged image"><img alt=""></div>
 
<footer>An unofficial fan page made for a cloud hosting project. Kuromi and all related characters belong to Sanrio.</footer>
 
<script>
// image fallbacks
document.querySelectorAll('.slot img').forEach(i=>{
  const f=()=>i.parentElement.classList.add('missing');
  i.addEventListener('error',f); if(i.complete&&!i.naturalWidth) f();
});
 
// typed tagline
const lines=["Cute on the outside. Trouble on the inside.","Punk princess of Mariland.","Plotting something. Probably."];
const tag=document.getElementById('tag');let li=0,ci=0,del=false;
(function type(){
  const s=lines[li];tag.textContent=s.slice(0,ci);
  if(!del&&ci<s.length){ci++;setTimeout(type,70)}
  else if(!del){del=true;setTimeout(type,1600)}
  else if(ci>0){ci--;setTimeout(type,30)}
  else{del=false;li=(li+1)%lines.length;setTimeout(type,300)}
})();
 
// tabs
document.querySelectorAll('.tabs button').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('.tabs button').forEach(x=>x.setAttribute('aria-selected',x===b));
  document.querySelectorAll('.panel').forEach(p=>p.hidden=p.id!==b.dataset.p);
});
 
// flip cards
document.querySelectorAll('.card').forEach(c=>c.onclick=()=>c.classList.toggle('on'));
 
// sparkle burst
const icons=['★','✦','♥','☠','✧'];
function burst(x,y,n=14){
  for(let k=0;k<n;k++){
    const s=document.createElement('span');s.className='sp';s.textContent=icons[Math.random()*icons.length|0];
    s.style.left=x+'px';s.style.top=y+'px';s.style.color=Math.random()>.5?'#ff5fa8':'#c9a7ff';
    s.style.setProperty('--x',(Math.random()*160-80)+'px');s.style.setProperty('--y',(Math.random()*160-80)+'px');
    document.body.appendChild(s);setTimeout(()=>s.remove(),900);
  }
}
const title=document.getElementById('title');
title.onclick=e=>{burst(e.clientX,e.clientY);title.classList.remove('shake');void title.offsetWidth;title.classList.add('shake')};
document.getElementById('boo').onclick=e=>{
  const r=e.target.getBoundingClientRect();
  for(let i=0;i<6;i++)setTimeout(()=>burst(Math.random()*innerWidth,Math.random()*innerHeight*.8,10),i*120);
};
let last=0;
addEventListener('pointermove',e=>{ if(e.pointerType==='mouse'&&Date.now()-last>90){last=Date.now();burst(e.clientX,e.clientY,1)} });
 
// countdown to Oct 31
const cd=document.getElementById('cd'),msg=document.getElementById('cdmsg');
function tick(){
  const now=new Date();let t=new Date(now.getFullYear(),9,31);
  if(now.getMonth()===9&&now.getDate()===31){cd.innerHTML='<b style="font-family:Shrikhand;font-size:3rem;font-weight:400">Happy birthday, Kuromi!</b>';msg.textContent='';return}
  if(now>t)t=new Date(now.getFullYear()+1,9,31);
  const d=t-now,v=[['days',d/864e5],['hours',d/36e5%24],['mins',d/6e4%60],['secs',d/1e3%60]];
  cd.innerHTML=v.map(([l,n])=>`<div><b>${String(Math.floor(n)).padStart(2,'0')}</b>${l}</div>`).join('');
  msg.textContent='Until October 31';
}
tick();setInterval(tick,1000);
 
// lightbox
const lb=document.getElementById('lb');
document.querySelectorAll('#gallery .slot').forEach(s=>s.onclick=()=>{
  if(s.classList.contains('missing'))return;
  lb.querySelector('img').src=s.querySelector('img').src;lb.classList.add('on');
});
lb.onclick=()=>lb.classList.remove('on');
addEventListener('keydown',e=>{if(e.key==='Escape')lb.classList.remove('on')});
 
// twinkling stars
const cv=document.getElementById('stars'),cx=cv.getContext('2d');let st=[];
function size(){cv.width=innerWidth;cv.height=innerHeight;st=Array.from({length:70},()=>({x:Math.random()*cv.width,y:Math.random()*cv.height,r:Math.random()*2+.5,p:Math.random()*6}))}
size();addEventListener('resize',size);
(function draw(t){
  cx.clearRect(0,0,cv.width,cv.height);
  st.forEach(s=>{cx.globalAlpha=.3+.7*Math.abs(Math.sin(t/900+s.p));cx.fillStyle='#c9a7ff';cx.beginPath();cx.arc(s.x,s.y,s.r,0,7);cx.fill()});
  requestAnimationFrame(draw);
})(0);
</script>
</body>
</html>
